#!/usr/bin/env php
<?php

declare(strict_types=1);

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../autoload.php'] as $autoload) {
    if (file_exists($autoload)) {
        require $autoload;
        break;
    }
}

use WpSpecter\Application;

$app = new Application();
exit($app->run($argv));
