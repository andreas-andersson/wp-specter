parameters:
    level: 8
    phpVersion:
        min: 80400
        max: 80500
    paths:
        - src
        - tests
        - bin/wp-specter
        - tools
    excludePaths:
        # Fake WP theme/plugin files used as scan targets in integration tests — call undefined
        # WP core functions by design, not real code to type-check.
        - tests/fixtures/*
    tmpDir: .phpstan-cache
