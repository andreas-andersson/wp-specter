{
    "name": "andreas-andersson/wp-specter",
    "description": "CLI tool to find unused code in WordPress projects",
    "keywords": ["cli", "wordpress", "unused code", "static analysis"],
    "authors": [{
        "name": "Andreas Andersson",
        "email": "andreas@aikon.se",
        "homepage": "https://aikon.se",
        "role": "Developer"
    }],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "WpSpecter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WpSpecter\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/wp-specter"
    ],
    "scripts": {
        "test": "vendor/bin/phpunit --colors=always",
        "lint": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "lint:fix": "vendor/bin/php-cs-fixer fix",
        "phpstan": "vendor/bin/phpstan analyse",
        "check": ["@lint", "@phpstan", "@test"],
        "update-wp-stubs": "php tools/generate-wp-hooks-stub.php"
    },
    "config": {
        "sort-packages": true
    }
}
